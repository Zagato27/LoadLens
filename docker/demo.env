# Variables of docker/docker-compose.demo.yml: demo-only values, nothing here is a secret.
# Always pass this file explicitly, so docker compose never reads docker/.env of a production install:
#   docker compose -f docker/docker-compose.demo.yml --env-file docker/demo.env --profile demo up --build
# Every variable has the same default inside the compose file; change them here, not there.

# Port of the demo on this host (bound to 127.0.0.1 only): http://localhost:5000
APP_PORT=5000

# Storage database of the demo stack (its own volume loadlens-demo_tsdb_data, port not published).
# settings.demo.py reads the same variables, so the application and the database always agree.
DEMO_DB_NAME=loadlens_demo
DEMO_DB_USER=loadlens
DEMO_DB_PASSWORD=loadlens-demo-password

# The administrator the demo signs in with (created on the first visit of the login page).
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=loadlens-demo

# Signs the session cookies of the demo; sessions survive a restart of the container.
DEMO_SECRET_KEY=demo-only-secret-key-not-for-production

# Seconds the model stub takes per answer: 0 makes the demo report appear faster, 3 looks like a real model.
DEMO_LLM_DELAY_SEC=1
