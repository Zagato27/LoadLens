# Порты по умолчанию (используются docker compose)
APP_PORT=5000
TSDB_PORT=5432
# Interface the database port is published on. 127.0.0.1 keeps it reachable from this host only;
# the app reaches the database over the compose network either way. 0.0.0.0 exposes it to the network.
TSDB_BIND=127.0.0.1

# TimescaleDB учётные данные (используются только контейнером БД)
# Приложение берёт доступы к БД из settings.py (storage.timescale)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=loadtesting
# Unprivileged role for the application (created by docker/initdb/03_app_role.sh on an empty volume).
# Put the same name and password into settings.py: storage.timescale.user / password.
# Lower-case letters, digits and _. Empty: the application keeps using POSTGRES_USER (a superuser).
APP_DB_USER=
APP_DB_PASSWORD=

# Redis/Celery (используются приложением и воркером)
# Required: Redis refuses clients without it, and `docker compose up` stops while it is empty.
# It becomes part of the broker URL, so use a URL-safe value, e.g. `openssl rand -hex 32`.
REDIS_PASSWORD=
# Broker and result backend default to redis://:<REDIS_PASSWORD>@redis:6379/0. Set them only for
# another Redis, with the password in the URL; values without a password stop Celery from connecting.
# CELERY_BROKER_URL=redis://:<password>@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:<password>@redis:6379/0
# 0 = Celery работает асинхронно; 1 = задачи выполняются синхронно (dev)
CELERY_TASK_ALWAYS_EAGER=0
# Where reports and Confluence publications (report and forecast) run:
#   auto   - in celery_worker when the broker is set and CELERY_TASK_ALWAYS_EAGER=0, otherwise in a
#            thread of the app container (the default; CELERY_TASK_ALWAYS_EAGER=1 therefore means thread)
#   thread - always in a thread of the app container, as before
#   celery - always in celery_worker; needs CELERY_TASK_ALWAYS_EAGER=0 (with 1 the task runs inside the request)
# When Redis does not accept a task, it still runs in a thread of the app container (warning in the log).
LOADLENS_JOB_RUNNER=auto
# A job in the worker that has not reported for this many minutes becomes an error ("worker does not
# respond"). The worker sends a heartbeat every 30 s, also during long LLM calls.
LOADLENS_JOB_STALE_MIN=15
# A job still waiting in the queue (no worker has taken it) for this many minutes becomes an error.
LOADLENS_JOB_QUEUE_MAX_MIN=120
# Time limit of one report or publication in the worker, seconds. At the limit the job ends with an
# error; 60 s later the worker process is killed.
LOADLENS_REPORT_TASK_LIMIT_SEC=3600
# Reports and publications the worker runs at once (worker processes). Each process holds the data of
# one report: raise WORKER_MEMORY_LIMIT with it. Jobs above it wait in the queue "reports".
WORKER_CONCURRENCY=2

# Container limits (docker compose applies deploy.resources.limits)
APP_CPUS=2
APP_MEMORY_LIMIT=2g
WORKER_CPUS=1
WORKER_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=512m

# Authentication (read by the app container)
# 1 = login required (default); 0 = open access with administrator rights for everyone
LOADLENS_AUTH_ENABLED=1
# Signs session cookies. Set a long random value (e.g. `openssl rand -hex 32`) and keep it stable:
# without it a key is generated inside the container and sessions end whenever it is recreated.
LOADLENS_SECRET_KEY=
# The first administrator, created on the first visit to /login while there are no users at all.
# Remove LOADLENS_ADMIN_PASSWORD from .env afterwards. Alternative without env vars:
#   docker compose exec app python -m loadlens_app.auth create-user admin --role admin
LOADLENS_ADMIN_USER=admin
LOADLENS_ADMIN_PASSWORD=
# Recovery administrator: signs in only while the storage database is down and can only fix the
# storage connection on /recovery. Hash: docker compose exec app python -m loadlens_app.auth hash-password
# Keep the hash in single quotes: unquoted, docker compose cuts it at the first $.
# LOADLENS_RECOVERY_USER=recovery
# LOADLENS_RECOVERY_PASSWORD_HASH='scrypt:32768:8:1$...'
# Behind an HTTPS reverse proxy: mark cookies Secure and trust the proxy's X-Forwarded-* headers
LOADLENS_COOKIE_SECURE=
LOADLENS_TRUSTED_PROXIES=

## Примечания
## - .env автоматически подхватывается docker compose.
## - Переменные POSTGRES_* и APP_PORT/TSDB_PORT читает только docker compose; LOADLENS_* и CELERY_* передаются приложению; CELERY_*, LOADLENS_JOB_* и LOADLENS_REPORT_* — ещё и воркеру.
## - Для продакшна используйте отдельные пароли и пользовательские сети docker.
