# ОС/IDE
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
# Test coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml
# deepeval cache (G-Eval experiments)
.deepeval/
# Personal Claude Code settings; shared ones in .claude/ stay in git
.claude/settings.local.json

# Виртуальные окружения
venv/
.venv/

# Сборочные артефакты
build/
dist/
*.spec

# Docker/Compose локальные файлы
**/.env
.env
.env.*
*.log

# Действующие конфиги (игнорируем секреты)
settings.py
# Runtime settings and their backups (e.g. settings_runtime.before-data-sources.json) hold secrets
settings_runtime*.json
# Temporary files of atomic writes of the runtime configs (a crash mid-write can leave one behind)
.*.json.*.tmp
metrics_config.py
metrics_config_runtime.json
AI/config.py

# Local overrides and secret files next to the configs (e.g. settings.local.py, smtp.secrets.json)
*.local.*
*.secrets.*

# Примеры конфигов оставляем в гите
!settings.example.py
!metrics_config.example.py
!docker/env.example
!loadlens_app/blueprints/settings.py

# Локальные/сгенерированные артефакты отчётов и сборщиков метрик
data_collectors/temporary_files/
k6-load-testing-results*.json
opensearch_error_report.md
opensearch_logs_config.json
AI/GigaChat/

# Session signing key generated on first start
.loadlens_secret_key

# UI/e2e sandboxes live in %TEMP%/ll_ui_s<N> (tools/bench_endpoints.py); a copy made here stays local
/sandbox/
/sandbox-*/

# Local copies and forks of the project kept next to it
/loadlens-fork*/
/loadlens_fork*/

# Results of tools/bench_endpoints.py --json written at the repository root (plans/perf-baseline.md)
/before*.json
/after*.json
/thread*.json
/celery*.json
/bench*.json

# Wheels for the dev-stack FastAPI app, downloaded on the host (docker/dev-stack/README.md)
docker/dev-stack/pyapp/wheels/
# Gatling bundle of the dev stack, unpacked on the host (docker/dev-stack/README.md)
docker/dev-stack/gatling/bundle/
# SSH key pair of the dev-stack load generator, generated on the host (docker/dev-stack/README.md)
docker/dev-stack/generator/keys/
docker/dev-stack/generator/wheels/

# Maintainer-only design plans and measurements (Russian); not part of the published repository
/plans/

# Local Claude Code settings, locks and worktrees
/.claude/
